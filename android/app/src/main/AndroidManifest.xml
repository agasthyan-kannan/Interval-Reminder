<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.interval_reminder">

    <!-- =======================================================================
         PERMISSIONS FOR LOCAL NOTIFICATIONS & EXACT ALARMS
         ======================================================================= -->

    <!-- 1. POST_NOTIFICATIONS:
         Starting in Android 13 (API 33), apps must declare this permission to
         display any notification to the user. At runtime, the app will prompt
         the user to grant or deny notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 2. SCHEDULE_EXACT_ALARM & USE_EXACT_ALARM:
         Required on Android 12+ (API 31+) to allow the app to schedule alarms
         that fire at precise times (exactAllowWhileIdle). Without these, Android
         may batch or delay notifications by 10-30 minutes to conserve battery. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- 3. VIBRATE:
         Allows notifications to trigger device vibration patterns. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- 4. RECEIVE_BOOT_COMPLETED:
         When an Android device restarts, all scheduled alarms in AlarmManager
         are wiped clean by the OS! This permission allows the notification
         plugin to wake up immediately after reboot and reschedule alarms. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="Interval Reminder"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ===================================================================
             RECEIVERS REQUIRED BY flutter_local_notifications
             =================================================================== -->

        <!-- ScheduledNotificationReceiver:
             Wakes up when the Android AlarmManager fires an exact alarm,
             building and displaying the notification in the status bar. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- ScheduledNotificationBootReceiver:
             Catches the BOOT_COMPLETED intent when the device finishes rebooting,
             restoring any scheduled notifications. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
